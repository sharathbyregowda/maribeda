{
    "name": "Maribeda",
    "short_name": "Maribeda",
    "description": "Your private digital diary. No cloud, no accounts.",
    "start_url": "/",
    "display": "standalone",
    "theme_color": "#4a90a4",
    "background_color": "#f0f4f8",
    "icons": [
        {
            "src": "/logo.jpg",
            "sizes": "192x192",
            "type": "image/jpeg"
        },
        {
            "src": "/logo.jpg",
            "sizes": "512x512",
            "type": "image/jpeg"
        }
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "application/x-sqlite3": [
                    ".sqlite",
                    ".db"
                ]
            }
        }
    ]
}